# List available recipes
default:
    @just --list

# Variables (to simplify internal pieces of subsequent recipes)
manage := "docker compose exec app python app/manage.py"

# Start all services in the background
up:
    docker compose up -d

# End all services
down *args:
    docker compose down {{args}}

# Restart an app
restart:
    docker compose restart app

# (Re)build images
build *args:
    docker compose build {{args}}

# Apply database migrations
migrate:
    {{manage}} migrate

# Create new migrations after changing models
makemigrations *args:
    {{manage}} makemigrations {{args}}

# Run the test suite in a container (extra arguments passed to `pytest`)
test *args:
    docker compose run --rm --build test pytest {{args}}

# Run just local tests (faster-for when Postgres isn't needed)
test-local *args:
    uv run pytest {{args}}

# Django shell (Python + ORM)
shell:
    {{manage}} shell

# psql prompt in the database container
dbshell:
    docker compose exec db sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

# Follow logs
logs service="":
    docker compose logs -f --tail=100 {{service}}

# Import a CSV
import file *flags:
    test -f data/{{file}} || (echo "no such file: data/{{file}}" && exit 1)
    {{manage}} import_hours /data/{{file}} {{flags}}

# After confirmation, delete containers _and_ database volume, then rebuild from scratch
[confirm("This deletes all database data. Continue? (y/n)")]
nuke:
    just down -v
    just build --no-cache

# Run ruff format fixes
style *paths:
    uv run ruff format {{ if paths == "" { "." } else { paths } }}

# Lint to complement the pre-commit hook
lint:
    uv run pre-commit run --all-files
