# List available recipes
default:
    @just --list

# Start all services in the background
up:
    docker compose up -d

# End all services
down:
    docker compose down

# Restart an app
restart:
    docker compose restart app

# (Re)build images
build *args:
    docker compose build {{args}}

# Run the test suite in a container (extra arguments passed to `pytest`)
test *args:
    docker compose run --rm --build test pytest {{args}}

# Run just local tests (faster-for when Postgres isn't needed)
test-local *args:
    uv run pytest {{args}}

# Run ruff format fixes
ruff:
    uv run ruff format .
