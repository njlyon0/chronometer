# List available recipes
default:
    @just --list

# Start all services in the background
up:
    docker compose up -d

# End all services
down:
    docker compose down

# Restart an app
restart:
    docker compose restart app

# (Re)build images
build *args:
    docker compose build {{args}}


# Run ruff format fixes
ruff:
    uv run ruff format .
