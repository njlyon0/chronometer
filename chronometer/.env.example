# Copy to `.env` and fill in real values (`.env` is gitignored)
POSTGRES_USER=name
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chronometer
## Define key with `uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"`
SECRET_KEY=set-me
## SECURITY WARNING: don't run with debug turned on in production!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
